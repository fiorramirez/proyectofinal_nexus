{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NEXUS API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Nexus.Api/bin/Debug/net8.0/Nexus.Api.dll",
      "cwd": "${workspaceFolder}/src/Nexus.Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5080" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
